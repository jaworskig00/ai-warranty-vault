# ─────────────────────────────────────────────────────────────────────────────
# AI Warranty Vault — document assistant service (services/ai)
#
# Copy to services/ai/.env. This file is the tracked template; `.env` is
# git-ignored. Every value here is SERVER-SIDE — none of it reaches the mobile app,
# which only ever learns this service's base URL.
#
# YOU DO NOT NEED MOST OF THIS FILE. Everything below has a working default in
# app/config.py; the rest of this template exists to document the knobs and explain
# why each default is what it is. A real `.env` only needs the values that have no
# sensible default — five lines:
#
#     DATABASE_URL=
#     SUPABASE_URL=
#     SUPABASE_SERVICE_ROLE_KEY=
#     OPENAI_API_KEY=
#     ANTHROPIC_API_KEY=
#
# Local Supabase stack: the first two already default to the right values, so only
# the three keys are needed. `npx supabase start` prints the service-role key and
# `npx supabase status` prints the JWT secret.
#
# Hosted Supabase project: all five, from the dashboard —
#   DATABASE_URL               Project Settings -> Database -> Connection string -> URI
#                              (Direct connection or Session pooler. NOT the
#                              Transaction pooler on 6543: psycopg's prepared
#                              statements break there. Percent-encode the password
#                              if it contains @ : / or #.)
#   SUPABASE_URL               Project Settings -> API -> Project URL
#   SUPABASE_SERVICE_ROLE_KEY  Project Settings -> API keys -> service_role
#   SUPABASE_JWT_SECRET        Project Settings -> API, *only if* a "JWT Secret" is
#                              shown. Newer projects show JWT signing keys instead;
#                              leave it unset and the service fetches the public
#                              keys from the project's JWKS endpoint by itself.
#
# Then run `python scripts/preflight.py`, which checks the database, the schema and
# every configured model before you rely on any of it.
# ─────────────────────────────────────────────────────────────────────────────

# ── database ────────────────────────────────────────────────────────────────
# Local Supabase stack (`npx supabase start`) uses the DSN below.
# Hosted Supabase: Project settings -> Database -> Connection string (direct).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Role the worker and the server-side writes run as. Must own the tables or have
# BYPASSRLS. Request-scoped work always switches to `authenticated` regardless.
DB_PRIVILEGED_ROLE=postgres

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=http://127.0.0.1:54321
# Used only by the indexing worker, to read an uploaded document out of the
# private bucket after the caller's token has expired. Never sent to a model.
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
# Token verification. Set ONE of these:
#   * SUPABASE_JWT_SECRET  — symmetric HS256 (local stacks, older projects).
#   * SUPABASE_JWKS_URL    — asymmetric ES256/RS256. Defaults to
#                            $SUPABASE_URL/auth/v1/.well-known/jwks.json.
SUPABASE_JWT_SECRET=your-local-jwt-secret
# SUPABASE_JWKS_URL=
# SUPABASE_JWT_ISSUER=https://YOUR-PROJECT-ref.supabase.co/auth/v1

# ── providers ───────────────────────────────────────────────────────────────
# `live` calls real providers. `mock` uses deterministic stand-ins and is for
# offline development and tests only — it never engages as a fallback, so a
# provider outage is reported as an error rather than silently degrading.
PROVIDER_MODE=live

# Embeddings. See services/ai/app/config.py for why this model and this width.
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-large
# Must match the vector column width in the migration. Changing it needs a
# migration and a full reindex; the service refuses to start on a mismatch.
EMBEDDING_DIMENSIONS=1024

# Answering, tool selection, and reading scanned documents.
#
# Do NOT add TEMPERATURE, TOP_P or TOP_K here or in the code: this model generation
# removed them and returns 400 `temperature is deprecated for this model`. Depth is
# controlled by the two effort settings below.
ANTHROPIC_API_KEY=sk-ant-...
ANSWER_MODEL=claude-opus-5-5
VISION_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max. Answering, routing, drafting.
MODEL_EFFORT=medium
# Transcription is mechanical and is the expensive path (one call per few pages).
VISION_EFFORT=low

# ── retrieval ───────────────────────────────────────────────────────────────
RETRIEVAL_MODE=hybrid
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATES=40
# Most chunks any single document may contribute to one answer. Without it a long
# document fills the whole top-k and a second document that contradicts it never
# reaches the model, so a disagreement is reported as a settled answer. 0 disables.
RETRIEVAL_PER_DOCUMENT=3
RETRIEVAL_MIN_SCORE=0.012
CONTEXT_TOKEN_BUDGET=3500

# ── chunking ────────────────────────────────────────────────────────────────
# Changing either of these changes INDEX_VERSION, so existing documents are
# excluded from search until they are reindexed.
CHUNK_TARGET_TOKENS=350
CHUNK_OVERLAP_TOKENS=60

# ── limits ──────────────────────────────────────────────────────────────────
MAX_DOCUMENT_BYTES=15728640
MAX_DOCUMENT_PAGES=60
MAX_OCR_PAGES=12
MAX_TOOL_STEPS=4
MODEL_TIMEOUT_SECONDS=60

# ── worker ──────────────────────────────────────────────────────────────────
WORKER_ID=local-worker
WORKER_CONCURRENCY=2
WORKER_LEASE_SECONDS=300

# ── http ────────────────────────────────────────────────────────────────────
# Comma-separated. Expo web and the simulator do not need CORS, but a browser
# does; narrow this in anything that is not a local dev machine.
CORS_ALLOW_ORIGINS=*

# ── optional tuning ─────────────────────────────────────────────────────────
# Every setting below has a working default (shown) in app/config.py. Uncomment
# only to change it.
# DB_POOL_MIN=1
# DB_POOL_MAX=8
# DB_STATEMENT_TIMEOUT_MS=15000
# SUPABASE_JWT_AUDIENCE=authenticated
# JWKS_CACHE_SECONDS=600
# EMBEDDING_BATCH_SIZE=64
# Thinking tokens count against this ceiling; too tight truncates answers.
# ANSWER_MAX_TOKENS=16000
# MODEL_MAX_RETRIES=2
# Changing CHUNK_MIN_TOKENS changes INDEX_VERSION, like the chunking settings above.
# CHUNK_MIN_TOKENS=24
# Noise floor for vector-only retrieval (hybrid uses RETRIEVAL_MIN_SCORE).
# RETRIEVAL_MIN_VECTOR_SIMILARITY=0.18
# OCR_PAGE_DPI=150
# WORKER_POLL_SECONDS=2
# WORKER_BACKOFF_BASE_SECONDS=15
# Postgres schema holding LangGraph checkpoints.
# GRAPH_SCHEMA=ai_graph
# REQUEST_TIMEOUT_SECONDS=120

# ── tests only ──────────────────────────────────────────────────────────────
# The suite creates and resets its own database. Override if 5432 is taken.
# TEST_ADMIN_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/postgres
# TEST_DATABASE_NAME=ai_vault_test
