{
  "name": "ai-warranty-vault",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.110.8",
    "@tanstack/react-query": "^5.101.4",
    "date-fns": "^4.4.0",
    "expo": "~57.0.8",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.7",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.2",
    "expo-image-manipulator": "~57.0.6",
    "expo-image-picker": "~57.0.6",
    "expo-linking": "~57.0.4",
    "expo-notifications": "~57.0.7",
    "expo-router": "~57.0.8",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.2",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.6",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "db:reset": "npx supabase db reset",
    "db:types": "npx supabase gen types typescript --local > src/types/database.ts",
    "verify:backend": "node scripts/verify-backend.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "verify:extract-fn": "node scripts/verify-extract-fn.mjs",
    "fn:serve": "npx supabase functions serve --env-file supabase/.env",
    "verify:reminders": "node scripts/verify-reminders.mjs",
    "lint:fix": "eslint . --fix",
    "ai:serve": "cd services/ai && .venv/bin/python -m uvicorn app.main:app --port 8000 --reload",
    "ai:worker": "cd services/ai && .venv/bin/python -m app.ingest.worker",
    "ai:test": "cd services/ai && .venv/bin/python -m pytest",
    "ai:preflight": "cd services/ai && .venv/bin/python scripts/preflight.py",
    "ai:eval": "cd services/ai && .venv/bin/python -m eval.run_eval --answers",
    "ai:walkthrough": "cd services/ai && .venv/bin/python scripts/demo_walkthrough.py"
  },
  "private": true
}
