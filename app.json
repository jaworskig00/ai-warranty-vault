{
  "expo": {
    "name": "AI Warranty Vault",
    "slug": "ai-warranty-vault",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "warrantyvault",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0B1120"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.warrantyvault.app",
      "infoPlist": {
        "NSCameraUsageDescription": "AI Warranty Vault uses the camera so you can photograph receipts and warranties.",
        "NSPhotoLibraryUsageDescription": "AI Warranty Vault needs photo access so you can attach existing receipt photos."
      }
    },
    "android": {
      "package": "com.warrantyvault.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B1120",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "AI Warranty Vault uses the camera so you can photograph receipts and warranties."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AI Warranty Vault needs photo access so you can attach existing receipt photos."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2563EB"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
